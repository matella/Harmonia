<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy: Harmonia data stays on this device. Cloud backup and device-to-device
  transfer of the database, photos and widget snapshot are excluded; users move their
  data explicitly with Settings › Privacy and data › Export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
