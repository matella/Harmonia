<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hm_canvas"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="serif"
            android:text="@string/config_title"
            android:textColor="@color/hm_ink"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/config_counter"
            android:textColor="@color/hm_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/config_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/config_counter_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/hm_berry"
                android:minHeight="48dp"
                android:text="@string/config_counter_app"
                android:textColor="@color/hm_ink" />

            <RadioButton
                android:id="@+id/config_counter_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/hm_berry"
                android:minHeight="48dp"
                android:text="@string/config_counter_days"
                android:textColor="@color/hm_ink" />

            <RadioButton
                android:id="@+id/config_counter_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/hm_berry"
                android:minHeight="48dp"
                android:text="@string/config_counter_calendar"
                android:textColor="@color/hm_ink" />
        </RadioGroup>

        <Switch
            android:id="@+id/config_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/config_details"
            android:textColor="@color/hm_ink"
            android:textSize="16sp"
            android:thumbTint="@color/hm_berry" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_details_hint"
            android:textColor="@color/hm_ink_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/config_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/hm_berry"
            android:minHeight="52dp"
            android:text="@string/config_save"
            android:textAllCaps="false"
            android:textColor="@color/hm_on_berry"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
