    <string name="widget_next_untitled">Prochaine date</string>
    <string name="widget_years_months">%1$s, %2$s</string>
    <!-- Label beside a number drawn separately; French "one" (0 and 1) is correct here. -->
    <plurals name="widget_days_label" tools:ignore="ImpliedQuantity">
        <item quantity="one">jour</item>
        <item quantity="many">jours</item>
        <item quantity="other">jours</item>
    </plurals>
    <plurals name="widget_days_together">
        <item quantity="one">%1$s jour ensemble</item>
        <item quantity="many">%1$s jours ensemble</item>
        <item quantity="other">%1$s jours ensemble</item>
    </plurals>
    <plurals name="widget_in_days">
        <item quantity="one">dans %1$s jour</item>
        <item quantity="many">dans %1$s jours</item>
        <item quantity="other">dans %1$s jours</item>
    </plurals>
    <plurals name="widget_years">
        <item quantity="one">%d an</item>
        <item quantity="many">%d ans</item>
        <item quantity="other">%d ans</item>
    </plurals>
    <plurals name="widget_months">
        <item quantity="one">%d mois</item>
        <item quantity="many">%d mois</item>
        <item quantity="other">%d mois</item>
    </plurals>

