<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Widgets -->
    <string name="widget_small_name">Jours ensemble</string>
    <string name="widget_small_description">Votre nombre de jours et le logo Harmonia.</string>
    <string name="widget_medium_name">Ensemble et prochaine date</string>
    <string name="widget_medium_description">Votre compteur et la prochaine date qui compte.</string>
    <string name="widget_placeholder">Ouvrez Harmonia pour commencer</string>
    <string name="widget_with_name">Vous et %1$s</string>
