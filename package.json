{
  "name": "harmonia",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "bun run test:domain && bun run test:ui",
    "test:domain": "vitest run",
    "test:ui": "ng test --watch=false",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "cap:sync": "ng build && cap sync",
    "android:sync": "ng build && cap sync android",
    "android:build": "bun run android:sync && node scripts/gradle.mjs assembleDebug",
    "android:build:dev": "ng build --configuration development && cap sync android && node scripts/gradle.mjs assembleDebug",
    "android:test": "node scripts/gradle.mjs :harmonia-core:test :app:testDebugUnitTest",
    "android:release": "bun run android:sync && node scripts/gradle.mjs bundleRelease",
    "ios:sync": "ng build && cap sync ios"
  },
  "private": true,
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/text-zoom": "^8.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@ionic/angular": "^9.0.8",
    "@supabase/supabase-js": "^2.118.0",
    "fflate": "^0.8.3",
    "ionicons": "^8.1.0",
    "libsodium-wrappers": "^0.8.4",
    "rxjs": "~7.8.0",
    "sql.js": "^1.15.0",
    "temporal-polyfill": "^1.0.6",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/sql.js": "^1.4.11",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "description": "Harmonia — a private, offline-first relationship companion."
}
